server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Backend calls must never receive the SPA's index.html as a fake success.
    location /api/ {
        default_type application/json;
        return 404 '{"error":"Frontend service has no API proxy. Configure VITE_API_URL before building."}';
    }

    # Vite gives these assets content hashes; stale HTML must not be cached.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
