# ============================================================
# SASTRA Backend - salin file ini menjadi backend/.env
# ============================================================

# Provider LLM aktif: gemini | ollama
LLM_PROVIDER=gemini

# --- Google Gemini (cloud) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (LLM lokal, https://ollama.com) ---
OLLAMA_BASE_URL=http://localhost:11434
# Model teks untuk Assessment & Report Agent
OLLAMA_MODEL=gemma3:4b
# Model multimodal untuk Vision Grader (kosongkan = pakai OLLAMA_MODEL)
# Contoh: gemma3:4b, qwen2.5vl:7b, llava:7b, llama3.2-vision:11b
OLLAMA_VISION_MODEL=
# Batas waktu satu request (detik); model lokal di CPU bisa lambat
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.4
# Panjang konteks; output JSON modul/kuis cukup panjang, jangan terlalu kecil
OLLAMA_NUM_CTX=8192
# Berapa lama model tetap dimuat di memori setelah request terakhir
OLLAMA_KEEP_ALIVE=10m
