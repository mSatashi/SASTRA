# Explicit upload list for: gcloud builds submit --ignore-file=.gcloudignore.app
**
!Dockerfile
!.dockerignore
!cloudbuild.app.yaml
!README.md
!AGENTS.md
!backend/
!backend/requirements.txt
!backend/app/
!backend/app/**
!frontend/
!frontend/**
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
**/.env
**/.env.*
**/.npmrc
**/.yarnrc*
**/__pycache__/
**/*.pyc
**/*.tsbuildinfo
**/*.log
**/*.pem
**/*.key
**/*credentials*.json
**/*service-account*.json
